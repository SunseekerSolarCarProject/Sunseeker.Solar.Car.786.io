<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Adopt a Cell | Sunseeker Solar Car</title>

  <style>
    :root {
      --green: #16834b;
      --dark-green: #0b4d2c;
      --light-green: #e9f7ef;
      --purple: #4b2a78;
      --gold: #f4c542;
      --white: #ffffff;
      --gray: #f4f5f6;
      --dark: #17221c;
      --border: #d8dedb;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: var(--gray);
      color: var(--dark);
    }

    /* ---------------- HEADER ---------------- */

    header {
      background: var(--dark-green);
      color: white;
      padding: 18px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: 1px;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 25px;
      font-weight: 600;
    }

    nav a:hover {
      text-decoration: underline;
    }

    /* ---------------- HERO ---------------- */

    .hero {
      background: linear-gradient(
        135deg,
        var(--dark-green),
        var(--purple)
      );

      color: white;
      text-align: center;
      padding: 75px 20px;
    }

    .hero h1 {
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      margin: 0 0 15px;
    }

    .hero p {
      max-width: 750px;
      margin: auto;
      font-size: 1.2rem;
      line-height: 1.7;
    }

    .price {
      margin-top: 30px;
      font-size: 2rem;
      font-weight: 800;
    }

    /* ---------------- MAIN ---------------- */

    main {
      max-width: 1200px;
      margin: auto;
      padding: 60px 20px;
    }

    .section-title {
      text-align: center;
      margin-bottom: 35px;
    }

    .section-title h2 {
      font-size: 2.3rem;
      margin-bottom: 10px;
      color: var(--dark-green);
    }

    .section-title p {
      color: #59635e;
    }

    /* ---------------- CAR ---------------- */

    .car-wrapper {
      background: white;
      border-radius: 20px;
      padding: 35px;
      box-shadow: 0 8px 30px rgba(0,0,0,.08);
      margin-bottom: 45px;
    }

    .car {
      max-width: 850px;
      margin: auto;
      position: relative;
    }

    /*
      Solar array representation.

      This is intentionally a simplified top-down
      representation. Replace it later with an actual
      Sunseeker car image/SVG.
    */

    .car-body {
      background: #252a28;
      border-radius: 50% 50% 25% 25%;
      padding: 45px 35px;
      transform: perspective(800px) rotateX(8deg);
    }

    .solar-array {
      display: grid;
      grid-template-columns: repeat(10, 1fr);
      gap: 5px;
      background: #111;
      padding: 10px;
      border-radius: 15px;
    }

    .cell {
      aspect-ratio: 1.6 / 1;
      border: 1px solid #777;
      border-radius: 3px;
      cursor: pointer;
      transition: .15s ease;
      position: relative;
      background:
        linear-gradient(
          135deg,
          #273a4c,
          #162432
        );
    }

    .cell:hover {
      transform: scale(1.08);
      z-index: 5;
      box-shadow: 0 0 0 3px var(--gold);
    }

    .cell.available {
      outline: 2px solid rgba(22,131,75,.4);
    }

    .cell.adopted {
      background:
        linear-gradient(
          135deg,
          #f4c542,
          #c99500
        );
      cursor: pointer;
    }

    .cell-number {
      position: absolute;
      inset: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: .65rem;
      color: white;
      font-weight: bold;
    }

    .adopted .cell-number {
      color: #3b2d00;
    }

    /* ---------------- LEGEND ---------------- */

    .legend {
      display: flex;
      justify-content: center;
      gap: 25px;
      margin-top: 25px;
      flex-wrap: wrap;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: .9rem;
    }

    .legend-box {
      width: 20px;
      height: 20px;
      border-radius: 4px;
      background: #263b4c;
    }

    .legend-box.adopted {
      background: var(--gold);
    }

    /* ---------------- INFO CARDS ---------------- */

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin: 50px 0;
    }

    .card {
      background: white;
      padding: 30px;
      border-radius: 15px;
      box-shadow: 0 5px 20px rgba(0,0,0,.06);
      text-align: center;
    }

    .card-icon {
      font-size: 2.3rem;
      margin-bottom: 10px;
    }

    .card h3 {
      color: var(--dark-green);
    }

    .card p {
      line-height: 1.6;
      color: #59635e;
    }

    /* ---------------- MODAL ---------------- */

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.65);
      z-index: 100;
      padding: 20px;
      overflow-y: auto;
    }

    .modal.active {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-content {
      background: white;
      width: min(600px, 100%);
      border-radius: 20px;
      padding: 35px;
      position: relative;
      box-shadow: 0 20px 60px rgba(0,0,0,.3);
    }

    .close {
      position: absolute;
      right: 20px;
      top: 15px;
      font-size: 28px;
      cursor: pointer;
      color: #777;
    }

    .cell-status {
      display: inline-block;
      padding: 7px 12px;
      border-radius: 30px;
      background: var(--light-green);
      color: var(--dark-green);
      font-weight: bold;
      margin-bottom: 15px;
    }

    .cell-status.taken {
      background: #fff0c2;
      color: #795d00;
    }

    .modal h2 {
      font-size: 2rem;
      margin: 10px 0;
      color: var(--dark-green);
    }

    .modal-price {
      font-size: 1.7rem;
      font-weight: bold;
      margin: 20px 0;
    }

    /* ---------------- FORM ---------------- */

    .form-group {
      margin-bottom: 18px;
    }

    .form-group label {
      display: block;
      margin-bottom: 7px;
      font-weight: bold;
    }

    .form-group input,
    .form-group select {
      width: 100%;
      padding: 13px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 1rem;
    }

    .button {
      display: inline-block;
      width: 100%;
      padding: 15px;
      border: none;
      border-radius: 10px;
      background: var(--green);
      color: white;
      font-size: 1.05rem;
      font-weight: bold;
      cursor: pointer;
      margin-top: 10px;
    }

    .button:hover {
      background: var(--dark-green);
    }

    .button.secondary {
      background: #e9eceb;
      color: var(--dark);
    }

    /* ---------------- SUCCESS ---------------- */

    .success {
      text-align: center;
      display: none;
    }

    .success-icon {
      font-size: 4rem;
      margin-bottom: 15px;
    }

    .success h2 {
      color: var(--dark-green);
    }

    .cell-confirmation {
      background: var(--light-green);
      padding: 20px;
      border-radius: 12px;
      margin: 25px 0;
      font-size: 1.2rem;
    }

    /* ---------------- FOOTER ---------------- */

    footer {
      background: var(--dark-green);
      color: white;
      text-align: center;
      padding: 40px 20px;
      margin-top: 30px;
    }

    /* ---------------- MOBILE ---------------- */

    @media (max-width: 800px) {

      .cards {
        grid-template-columns: 1fr;
      }

      .solar-array {
        grid-template-columns: repeat(5, 1fr);
      }

      .car-body {
        padding: 25px 15px;
      }

      nav {
        display: none;
      }
    }

  </style>
</head>

<body>

<header>

  <div class="logo">
    ☀️ SUNSEEKER
  </div>

  <nav>
    <a href="#about">About</a>
    <a href="#cells">Adopt a Cell</a>
    <a href="#contact">Contact</a>
  </nav>

</header>


<!-- HERO -->

<section class="hero">

  <h1>Adopt a Cell</h1>

  <p>
    Put your name on the Sunseeker Solar Car.
    Adopt an individual solar cell that will become
    part of the car's solar array and help power
    our journey from the workshop to the race track.
  </p>

  <div class="price">
    $25 per cell
  </div>

</section>


<main>

  <!-- CELL SELECTOR -->

  <section id="cells">

    <div class="section-title">

      <h2>Choose Your Solar Cell</h2>

      <p>
        Select an available cell on the car below.
        Green-outlined cells are available to adopt.
        Gold cells have already been adopted.
      </p>

    </div>


    <div class="car-wrapper">

      <div class="car">

        <div class="car-body">

          <div
            class="solar-array"
            id="solarArray">
          </div>

        </div>

      </div>


      <div class="legend">

        <div class="legend-item">
          <span class="legend-box"></span>
          Available
        </div>

        <div class="legend-item">
          <span class="legend-box adopted"></span>
          Adopted
        </div>

      </div>

    </div>

  </section>


  <!-- INFO -->

  <section id="about">

    <div class="section-title">

      <h2>You're Supporting the Car Itself</h2>

      <p>
        Your adopted cell isn't just a donation.
        It becomes part of the solar array installed
        on a Sunseeker race car.
      </p>

    </div>


    <div class="cards">

      <div class="card">

        <div class="card-icon">☀️</div>

        <h3>Your Cell</h3>

        <p>
          Choose a specific solar cell and become
          part of the physical car.
        </p>

      </div>


      <div class="card">

        <div class="card-icon">🏎️</div>

        <h3>On the Car</h3>

        <p>
          Your cell will be installed as part of
          Sunseeker's solar array.
        </p>

      </div>


      <div class="card">

        <div class="card-icon">🏁</div>

        <h3>Follow the Journey</h3>

        <p>
          Follow Sunseeker as the team tests,
          travels, and competes.
        </p>

      </div>

    </div>

  </section>

</main>


<!-- CELL MODAL -->

<div class="modal" id="cellModal">

  <div class="modal-content">

    <span
      class="close"
      onclick="closeModal()">
      &times;
    </span>


    <!-- CELL DETAILS -->

    <div id="cellDetails">

      <span
        class="cell-status"
        id="cellStatus">
        AVAILABLE
      </span>

      <h2 id="selectedCell">
        Cell #001
      </h2>

      <p>
        This is an individual solar cell that will
        become part of the Sunseeker solar array.
      </p>

      <div class="modal-price">
        $25
      </div>

      <button
        class="button"
        onclick="showCheckout()">

        Adopt This Cell

      </button>

    </div>


    <!-- CHECKOUT -->

    <div
      id="checkout"
      style="display:none;">

      <h2>Adopt Your Cell</h2>

      <p>
        You're adopting
        <strong id="checkoutCell">
          Cell #001
        </strong>.
      </p>


      <div class="form-group">

        <label>
          Name to Display
        </label>

        <input
          type="text"
          id="donorName"
          placeholder="Your name, family, or organization">

      </div>


      <div class="form-group">

        <label>
          Email
        </label>

        <input
          type="email"
          id="donorEmail"
          placeholder="you@example.com">

      </div>


      <div class="form-group">

        <label>
          Display Preference
        </label>

        <select id="displayPreference">

          <option value="name">
            Display my name
          </option>

          <option value="family">
            Display my family name
          </option>

          <option value="organization">
            Display my organization
          </option>

          <option value="private">
            Keep my name private
          </option>

        </select>

      </div>


      <button
        class="button"
        onclick="completeAdoption()">

        Continue to Payment — $25

      </button>


      <button
        class="button secondary"
        onclick="backToCell()">

        Back

      </button>

    </div>


    <!-- SUCCESS -->

    <div
      class="success"
      id="success">

      <div class="success-icon">
        ☀️
      </div>

      <h2>
        Your Cell Has Been Adopted!
      </h2>

      <div class="cell-confirmation">

        <strong id="successCell">
          Cell #001
        </strong>

        <br>

        is now part of your Sunseeker story.

      </div>

      <p>
        Thank you for supporting the students
        building and racing Sunseeker.
      </p>

      <button
        class="button"
        onclick="closeModal()">

        Done

      </button>

    </div>

  </div>

</div>


<footer id="contact">

  <h3>
    Sunseeker Solar Car Project
  </h3>

  <p>
    Western Michigan University
  </p>

  <p>
    Every cell helps move us forward.
  </p>

</footer>


<script>

  /*
   * ------------------------------------------
   * CELL DATABASE
   * ------------------------------------------
   *
   * In the real version, this should come
   * from a database rather than JavaScript.
   *
   * Example:
   *
   * cell #1 = available
   * cell #2 = adopted
   *
   */

  const cells = [];

  const TOTAL_CELLS = 60;


  /*
   * Example adopted cells.
   *
   * Replace this with information pulled
   * from your real database.
   */

  const adoptedCells = {

    3: "WMU Alumni",

    7: "Sunseeker Supporter",

    12: "Smith Family",

    19: "Bronco Cyber",

    28: "Available Sponsor"

  };


  let selectedCellNumber = null;


  /*
   * ------------------------------------------
   * CREATE SOLAR CELLS
   * ------------------------------------------
   */

  const solarArray =
    document.getElementById("solarArray");


  for (
    let i = 1;
    i <= TOTAL_CELLS;
    i++
  ) {

    const cell =
      document.createElement("div");

    cell.classList.add("cell");


    /*
     * Determine whether cell is adopted.
     */

    if (adoptedCells[i]) {

      cell.classList.add("adopted");

    } else {

      cell.classList.add("available");

    }


    const number =
      document.createElement("span");

    number.classList.add("cell-number");

    number.textContent =
      String(i).padStart(3, "0");


    cell.appendChild(number);


    cell.addEventListener(
      "click",
      () => openCell(i)
    );


    solarArray.appendChild(cell);

  }


  /*
   * ------------------------------------------
   * OPEN CELL
   * ------------------------------------------
   */

  function openCell(number) {

    selectedCellNumber = number;


    const modal =
      document.getElementById("cellModal");


    const selectedCell =
      document.getElementById("selectedCell");


    const checkoutCell =
      document.getElementById("checkoutCell");


    const successCell =
      document.getElementById("successCell");


    selectedCell.textContent =
      `Cell #${String(number).padStart(3, "0")}`;


    checkoutCell.textContent =
      `Cell #${String(number).padStart(3, "0")}`;


    successCell.textContent =
      `Cell #${String(number).padStart(3, "0")}`;


    const status =
      document.getElementById("cellStatus");


    if (adoptedCells[number]) {

      status.textContent = "ADOPTED";

      status.classList.add("taken");


      /*
       * For now, adopted cells cannot
       * be purchased again.
       */

      document.querySelector(
        "#cellDetails .button"
      ).style.display = "none";

    } else {

      status.textContent = "AVAILABLE";

      status.classList.remove("taken");


      document.querySelector(
        "#cellDetails .button"
      ).style.display = "block";

    }


    document.getElementById(
      "cellDetails"
    ).style.display = "block";


    document.getElementById(
      "checkout"
    ).style.display = "none";


    document.getElementById(
      "success"
    ).style.display = "none";


    modal.classList.add("active");

  }


  /*
   * ------------------------------------------
   * SHOW CHECKOUT
   * ------------------------------------------
   */

  function showCheckout() {

    document.getElementById(
      "cellDetails"
    ).style.display = "none";


    document.getElementById(
      "checkout"
    ).style.display = "block";

  }


  /*
   * ------------------------------------------
   * BACK
   * ------------------------------------------
   */

  function backToCell() {

    document.getElementById(
      "checkout"
    ).style.display = "none";


    document.getElementById(
      "cellDetails"
    ).style.display = "block";

  }


  /*
   * ------------------------------------------
   * COMPLETE ADOPTION
   * ------------------------------------------
   *
   * IMPORTANT:
   *
   * This currently simulates payment.
   *
   * Connect this function to Stripe,
   * PayPal, or your actual payment system.
   *
   */

  function completeAdoption() {

    const name =
      document.getElementById(
        "donorName"
      ).value.trim();


    const email =
      document.getElementById(
        "donorEmail"
      ).value.trim();


    if (!name || !email) {

      alert(
        "Please enter your name and email."
      );

      return;

    }


    /*
     * Mark cell as adopted locally.
     */

    adoptedCells[
      selectedCellNumber
    ] = name;


    /*
     * Show confirmation.
     */

    document.getElementById(
      "checkout"
    ).style.display = "none";


    document.getElementById(
      "success"
    ).style.display = "block";


    /*
     * Update visual cell.
     */

    const allCells =
      document.querySelectorAll(".cell");


    const actualCell =
      allCells[selectedCellNumber - 1];


    actualCell.classList.remove(
      "available"
    );


    actualCell.classList.add(
      "adopted"
    );

  }


  /*
   * ------------------------------------------
   * CLOSE MODAL
   * ------------------------------------------
   */

  function closeModal() {

    document.getElementById(
      "cellModal"
    ).classList.remove("active");

  }


  /*
   * Close modal if user clicks outside it.
   */

  document.getElementById(
    "cellModal"
  ).addEventListener(
    "click",
    function(event) {

      if (event.target === this) {

        closeModal();

      }

    }
  );

</script>

</body>
</html>